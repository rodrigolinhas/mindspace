{
  "name": "mindspace",
  "version": "3.141592653589793",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "populate": "ts-node --project server/tsconfig.json server/src/populate.ts",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "ts-node --project server/tsconfig.json server/src/server.ts",
    "start:client": "vite preview --config client/vite.config.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --project server/tsconfig.json --respawn --transpile-only server/src/server.ts",
    "dev:client": "vite --config client/vite.config.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.10.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "typescript": "^5.5.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "prettier": "3.7.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "vite": "^5.2.0"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.21.5": true
  }
}
